# Normalize line endings in the repository to LF; check out source files as CRLF
* text=auto

*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cs   text eol=crlf
*.xaml text eol=crlf

*.md   text eol=lf
*.yml  text eol=lf
*.json text eol=lf

*.dll  binary
*.ico  binary
*.png  binary
